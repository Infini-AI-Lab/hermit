# AHE-Beta's own delivery Evolver (delivery/, run-delivery.yaml) only. Copy to a protected local file and source it
# before bootstrap.py and hermit train; never commit the filled file or write these values into JSON or YAML.
# The actor's and the simulated user's models are Hermit's settings (run.yaml), not variables here.

GITEA_TOKEN=

# AHE-Beta's demand roles (Triage, Architect, PM), read by its controller.
HARNESS_LLM_BASE_URL=
HARNESS_LLM_API_KEY=
HARNESS_LLM_MODEL=
DEMAND_LLM_BASE_URL=
DEMAND_LLM_API_KEY=
DEMAND_LLM_MODEL=

# The OpenAgents worker when it uses the NexAU backend.
OPENAGENTS_NEXAU_BASE_URL=
OPENAGENTS_NEXAU_API_KEY=
OPENAGENTS_NEXAU_MODEL=
