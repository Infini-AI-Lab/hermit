# AHE-Beta's own delivery Evolver (delivery/, run-delivery.yaml) only. Copy to a protected file outside the checkout
# (`~/.config/ahe-beta/experiment.env`, chmod 600) and source it before bootstrap.py and hermit train; never commit the
# filled file or write these values into JSON or YAML. The Evolver hands each process only the variables delivery.json
# names for it, in the run's sandbox.
# The actor's and the simulated user's models are Hermit's settings (run.yaml), not variables here.

export GITEA_TOKEN=

# AHE-Beta's demand roles (Triage, Architect, PM), read by its controller.
export HARNESS_LLM_BASE_URL=
export HARNESS_LLM_API_KEY=
export HARNESS_LLM_MODEL=
export DEMAND_LLM_BASE_URL=
export DEMAND_LLM_API_KEY=
export DEMAND_LLM_MODEL=
# export DEMAND_LLM_REASONING_EFFORT=           # optional, as AHE-Beta reads it

# The OpenAgents worker's developers (bootstrap.py configures them as Claude Code), on an Anthropic-compatible endpoint:
# one credential (ANTHROPIC_API_KEY, a gateway's ANTHROPIC_AUTH_TOKEN or CLAUDE_CODE_OAUTH_TOKEN); on a gateway, its
# model for the light calls too (AHE-Beta's runtime.py: without it those calls fail).
export ANTHROPIC_BASE_URL=
export ANTHROPIC_AUTH_TOKEN=
export ANTHROPIC_MODEL=
export ANTHROPIC_SMALL_FAST_MODEL=
